# Development: the Vite dev server proxies /api to this World Stock Exchange API.
VITE_API_TARGET=http://localhost:3001
# Production (Vercel): public URL of the API host. Listing-document uploads and signed document links go
# straight to it; everything else under /api goes through the website (middleware.js). Leave empty in
# development to send uploads through the dev proxy.
VITE_BACKEND_ORIGIN=
# Server-side Vercel settings used by middleware.js (set in the Vercel project, not exposed to browsers):
# BACKEND_ORIGIN=https://your-api.up.railway.app
# PROXY_SECRET=same value as the API's PROXY_SECRET
