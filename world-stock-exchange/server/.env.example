NODE_ENV=development
PORT=3001
# Website origin (the Vercel domain in production): CORS and email links.
APP_ORIGIN=http://localhost:5174

# PostgreSQL. Locally: `docker compose -p wse up -d db` with POSTGRES_PASSWORD set; on Railway reference the
# Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
POSTGRES_PASSWORD=
DATABASE_URL=postgres://wse:CHANGE_ME@127.0.0.1:5434/wse

# Required in production: random values of at least 32 characters.
JWT_SECRET=
# Same value as the Vercel project's PROXY_SECRET (client/middleware.js); see src/middleware/trustedProxy.js.
PROXY_SECRET=
# Express "trust proxy" hops for requests that reach this server directly. Railway = 2 (client, edge proxy).
TRUST_PROXY=

# Listing documents (private, served only through permission-checked links).
PRIVATE_UPLOAD_DIR=private-uploads
MAX_DOCUMENT_MB=20

# Practice trading: starting virtual balance in US dollars for every new account. No real money.
PRACTICE_BALANCE_USD=10000
# Gold & Diamond fund seller fee: rate, and basis "gross" (sale value, default) or "profit" (realised profit).
FUND_FEE_RATE=0.02
FUND_FEE_BASIS=gross

# Email (verification and password reset) via Resend: https://resend.com/api-keys
# EMAIL_FROM must use a domain verified in Resend, e.g. "World Stock Exchange <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Optional market data from Finnhub (https://finnhub.io/dashboard). Without a key, stored prices are shown
# and labelled "Illustrative data".
FINNHUB_API_KEY=
MARKET_REFRESH_MINUTES=15

# One-time import of the old SQLite database (Railway: /data/wse.sqlite). Remove after the import has run.
LEGACY_SQLITE_PATH=
