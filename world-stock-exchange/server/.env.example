NODE_ENV=development
PORT=3001
# Public origin of the client, used for CORS.
APP_ORIGIN=http://localhost:5174
DB_FILE=wse.sqlite
# Optional: path to the built client (client/dist) to serve it from this server in production.
CLIENT_DIST_DIR=
# Express "trust proxy": number of proxy hops in front of the server (2 behind Vercel + Railway).
TRUST_PROXY=
