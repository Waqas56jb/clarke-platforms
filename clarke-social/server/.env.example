NODE_ENV=development
PORT=3000
# Required in production: a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public origin of the client. Used for CORS and Stripe success/cancel redirects.
APP_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=100
UPLOAD_DIR=uploads
DB_FILE=clarke.sqlite
# Optional: path to the built client (client/dist) to serve it from this server in production.
CLIENT_DIST_DIR=
# Optional Stripe payments (use test keys first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional TURN relay for reliable voice/video calls
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Express "trust proxy": number of proxy hops in front of the server (2 behind Vercel + Railway).
TRUST_PROXY=
