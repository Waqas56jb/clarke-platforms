NODE_ENV=development
PORT=3000

# PostgreSQL. Local development: `docker compose up -d db` (see docker-compose.yml).
# Railway: reference the Postgres service, e.g. DATABASE_URL=${{Postgres-social.DATABASE_URL}}
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgres://clarke:REPLACE_WITH_A_LONG_RANDOM_SECRET@127.0.0.1:5433/clarke_social

# Required in production: random values of at least 32 characters, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Must match PROXY_SECRET in the Vercel project. Railway rejects /api requests without it.
PROXY_SECRET=

# Public website origin (Vercel domain in production). Used for CORS, email links and payment returns.
APP_ORIGIN=http://localhost:5173
# Express "trust proxy" for requests that reach this server directly. Railway's edge proxy = 1.
TRUST_PROXY=

UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads
MAX_UPLOAD_MB=100
MAX_MOVIE_UPLOAD_MB=500

# Email (verification and password reset) via Resend: https://resend.com/api-keys
# EMAIL_FROM must use a domain you verified in Resend, e.g. "Clarke <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# WiPay hosted checkout: https://docs.wipayfinancial.com (Dashboard > Developer > Payment API).
# Sandbox: WIPAY_ENVIRONMENT=sandbox, WIPAY_ACCOUNT_NUMBER=1234567890, WIPAY_API_KEY=123.
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
WIPAY_COUNTRY_CODE=GD
WIPAY_CURRENCY=USD
WIPAY_FEE_STRUCTURE=merchant_absorb

# TURN relay for calls across networks. Either static credentials (TURN_USERNAME/TURN_CREDENTIAL)
# or a coturn-style shared secret (TURN_SHARED_SECRET) for short-lived credentials.
# Comma-separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
