# Development: the Vite dev server proxies /api, /uploads and /socket.io to this Clarke Social API.
VITE_API_TARGET=http://localhost:3000
# Production (Vercel): public URL of the API host. Uploads, media, signed file links and the Socket.IO
# connection go straight to it; everything else under /api goes through the website (middleware.js).
VITE_BACKEND_ORIGIN=
# Server-side Vercel settings used by middleware.js (set in the Vercel project, not exposed to browsers):
# BACKEND_ORIGIN=https://your-api.up.railway.app
# PROXY_SECRET=same value as the API's PROXY_SECRET
