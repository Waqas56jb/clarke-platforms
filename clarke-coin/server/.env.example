APP_ENV=development
APP_NAME=Clarke Coin API
PORT=3002
# Generate independent secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use one strong random value for JWT_SECRET and a different one for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Host port docker-compose publishes PostgreSQL on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
DATABASE_URL=postgres://clarke:REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET@127.0.0.1:5432/clarke_coin
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=15
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5175
# Behind trusted reverse proxies set the number of hops (e.g. 2 for Vercel + Railway) so client IPs come from X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Production only: set to true to apply reviewed migrations when the server starts (e.g. on Railway).
RUN_MIGRATIONS_ON_START=false
